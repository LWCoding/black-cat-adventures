  SceneToLoad: EventLevel
  IntroText: 'A tarnished brass lamp rests half-buried in the dirt. When you brush
    it clean, smoke pours out and coils into a waiting shape. "One wish," it says.
    "But wishes have a price."'
  LeftImage: {fileID: 0}
  Options:
  - Label: Make a wish
    Description: Gain a random treasure. Your next battle starts cursed.
    Outcome:
      Type: 4
      Count: 0
      ChooseFrom: 0
    ResultText: The genie smiles and grants your wish — {0}. But it was right about
      the price.
    EmptyPoolText: The genie reaches into the smoke and finds nothing. Your wish goes
      unanswered.
    HideIfNoTreasures: 0
  - Label: Set it down
    Description: ''
    Outcome:
      Type: 0
      Count: 0
      ChooseFrom: 0
    ResultText: You bury the lamp again. Some wishes aren't worth their cost.
    EmptyPoolText: ''
    HideIfNoTreasures: 0
